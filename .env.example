# Optional runtime configuration (copy to `.env` — never commit it).
# All values are optional; CLI flags override them.

# zenvex receiving domain (souss.dev, znvx.me, zenvex.edu.pl, ...)
AGNES_DOMAIN=souss.dev

# Max ms to wait for the verification email
AGNES_TIMEOUT=120000

# Number of accounts and parallelism
AGNES_COUNT=1
AGNES_CONCURRENCY=1

# Set to 1 to run the browser visibly (debugging)
AGNES_HEADFUL=0
