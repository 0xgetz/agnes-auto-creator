# Agnes Auto Creator — fixed version (v1.1.0) configuration
# Copy to `.env`. CLI flags override these. Never commit real .env.

# Receiving domain. IMPORTANT: only souss.dev was verified to actually
# receive Agnes mail. Other zenvex domains accept the inbox but no mail
# arrives.
AGNES_DOMAIN=souss.dev

# Max ms to wait for the verification email once the inbox is open.
AGNES_TIMEOUT=180000

# Max ms to wait for the Cloudflare Turnstile challenge to complete.
AGNES_TURNSTILE_TIMEOUT=150000

# Retries per account on transient failures (mail delay, Turnstile, 5xx).
# Rate-limit errors abort immediately (retrying will not help).
AGNES_RETRIES=3

# Number of accounts and parallelism.
AGNES_COUNT=1
AGNES_CONCURRENCY=1

# Set to 1 to run the browser visibly (debugging).
AGNES_HEADFUL=0

# ---- Proxy ----------------------------------------------------------------
# Route BOTH Chromium and the Agnes API requests through a proxy.
# Format: http://user:pass@host:port  or  socks5://host:port
# Leave empty for direct connection.
#
# NOTE: "free" public proxy lists almost never work for Cloudflare-protected
# sites (measured 0/254 working). Use a paid residential proxy or a clean VPS.
AGNES_PROXY=

# Alternative: AGNES_PROXY can also be read from PROXY_URL / HTTPS_PROXY.
